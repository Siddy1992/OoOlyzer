# Build the marker-instrumented HPC2 (PINI) test binary for gem5 SE / O3.
#
# Auto-detects an available RISC-V cross toolchain. Order of preference:
#   1. riscv32-unknown-elf-   (native rv32 bare-metal)
#   2. riscv64-unknown-elf-   (64-bit multilib bare-metal; builds rv32 via -mabi=ilp32)
#   3. riscv64-linux-gnu-     (Linux GCC; also works for gem5 SE)
# Override explicitly if needed:
#   make -f Makefile.pini CROSS=riscv64-unknown-elf-
#   make -f Makefile.pini ITERS=32          # longer trace
#   make -f Makefile.pini MARCH=rv32i        # pure rv32i instead of rv32im
#   make -f Makefile.pini clean

CROSS ?= $(shell \
  if command -v riscv32-unknown-elf-gcc >/dev/null 2>&1; then echo riscv32-unknown-elf-; \
  elif command -v riscv64-unknown-elf-gcc >/dev/null 2>&1; then echo riscv64-unknown-elf-; \
  elif command -v riscv64-linux-gnu-gcc  >/dev/null 2>&1; then echo riscv64-linux-gnu-; \
  else echo riscv32-unknown-elf-; fi)

CC     := $(CROSS)gcc
MARCH  ?= rv32im
CFLAGS := -march=$(MARCH) -mabi=ilp32 -O0 -g -static
ITERS  ?= 8

TARGET := pini_test
SRCS   := main_pini.c pini_hpc2.S

$(TARGET): $(SRCS)
	@echo "using toolchain: $(CC)  ($(MARCH)/ilp32)"
	$(CC) $(CFLAGS) -DITERS=$(ITERS) -o $@ $(SRCS)
	@echo "built $@ -- sanity-run on a sim, expect 'pini_and2_hpc2 x$(ITERS): OK'"

clean:
	rm -f $(TARGET)

.PHONY: clean
